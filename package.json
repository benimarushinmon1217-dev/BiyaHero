{
  "name": "biyahero",
  "version": "1.0.0",
  "description": "AI-powered commuting companion for Batangas Province, Philippines",
  "type": "module",
  "private": true,
  "author": "BiyaHero Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/biyahero.git"
  },
  "keywords": [
    "transportation",
    "commute",
    "philippines",
    "batangas",
    "routing",
    "fare-calculator",
    "ai-assistant",
    "react",
    "vite"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\"",
    "dev:mock": "cd backend && npm run dev:mock",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend-only": "vite",
    "dev:backend-only": "cd backend && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "health-check": "node scripts/health-check.js"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "framer-motion": "^11.0.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^6.4.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}