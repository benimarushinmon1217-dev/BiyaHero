# Public API base URL, including /api/v1. Set in Render for the frontend build.
VITE_API_URL=

# Map Settings (Optional - defaults to Lipa City, Batangas)
VITE_DEFAULT_CENTER_LAT=13.9411
VITE_DEFAULT_CENTER_LNG=121.1650
VITE_DEFAULT_ZOOM=13

